<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ParagensV2"
             x:Class="ParagensV2.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#1A237E</Color>
            <Color x:Key="Accent">#28d8c3</Color>

            <!-- Light Mode Colors -->
            <Color x:Key="LightBackground">#F0F4F8</Color>
            <Color x:Key="LightCardBackground">#FFFFFF</Color>
            <Color x:Key="LightTextPrimary">#1E293B</Color>
            <Color x:Key="LightTextSecondary">#64748B</Color>
            <Color x:Key="LightBorder">#E2E8F0</Color>

            <!-- Dark Mode Colors -->
            <Color x:Key="DarkBackground">#0B1120</Color>
            <Color x:Key="DarkCardBackground">#1E293B</Color>
            <Color x:Key="DarkTextPrimary">#F8FAFC</Color>
            <Color x:Key="DarkTextSecondary">#94A3B8</Color>
            <Color x:Key="DarkBorder">#334155</Color>

            <!-- Default Fallback Keys -->
            <Color x:Key="Background">#F0F4F8</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#263238</Color>
            <Color x:Key="TextSecondary">#78909C</Color>
            <Color x:Key="Success">#2E7D32</Color>
            <Color x:Key="SuccessLight">#E8F5E9</Color>
            <Color x:Key="SuccessBorder">#A5D6A7</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>

