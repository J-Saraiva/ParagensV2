<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             xmlns:models="clr-namespace:ParagensV2.Models"
             x:Class="ParagensV2.Views.MetroStationDeparturesPage"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="#212e65" Padding="20,24,20,20">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Opacity="0.2" Radius="10" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Label Text="🚇 Metro do Porto • Estação" TextColor="#80D8FF" FontSize="13" FontAttributes="Bold" />
                    <Label Text="{Binding StationName}" TextColor="White" FontSize="24" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding StationZone, StringFormat='Zona {0}'}" TextColor="#80D8FF" FontSize="13" FontAttributes="Bold" />
                        <Label Text="•" TextColor="#CFD8DC" FontSize="13" />
                        <Label Text="{Binding StationLines, StringFormat='Linhas {0}'}" TextColor="#ECEFF1" FontSize="13" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Kebab Menu Button -->
                <Border Grid.Column="1" 
                        HeightRequest="38" 
                        WidthRequest="38" 
                        BackgroundColor="#152244" 
                        StrokeThickness="0" 
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnKebabMenuClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="⋮" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Departures List -->
        <Grid Grid.Row="1">
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#212e65" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40" />

            <Label Text="Sem partidas previstas para as próximas horas." 
                   TextColor="{StaticResource TextSecondary}" 
                   FontSize="16" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"
                   IsVisible="{Binding IsEmpty}" />

            <RefreshView IsRefreshing="{Binding IsLoading}" Command="{Binding RefreshCommand}" RefreshColor="#212e65">
                <CollectionView ItemsSource="{Binding Departures}" Margin="12,12,12,24">
                    <CollectionView.Header>
                        <Border StrokeThickness="0" BackgroundColor="#FFF9C4" Margin="4,4,4,10" Padding="12,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                                <Label Text="A mostrar horário afixado" TextColor="#F57F17" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MetroDeparture">
                            <Border StrokeThickness="0" BackgroundColor="{StaticResource CardBackground}" Margin="4,6,4,6" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Opacity="0.08" Radius="5" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                                    <!-- Line Letter Badge -->
                                    <Border Grid.Column="0" HeightRequest="46" WidthRequest="46" BackgroundColor="{Binding LineColor}" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Line}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <!-- Destination & Time Details -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Destination}" TextColor="{StaticResource TextPrimary}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding TimeSubtitle}" TextColor="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" />
                                    </VerticalStackLayout>

                                    <!-- ETA Badge -->
                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center">
                                        <Border StrokeThickness="0" BackgroundColor="#E0F2F1" Padding="10,6" HorizontalOptions="End">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding EstimatedTimeDisplay}" TextColor="#004D40" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
