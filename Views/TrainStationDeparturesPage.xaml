<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             xmlns:models="clr-namespace:ParagensV2.Models"
             x:Class="ParagensV2.Views.TrainStationDeparturesPage"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="#1b652d" Padding="20,24,20,18">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Opacity="0.2" Radius="10" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="🚆 Partidas e Chegadas" TextColor="#A7F3D0" FontSize="13" FontAttributes="Bold" />
                    <Label Text="{Binding StationName}" TextColor="White" FontSize="24" FontAttributes="Bold" Margin="0,3,0,0" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding StationCode, StringFormat='Rede Ferroviária Nacional • Código {0}'}" TextColor="#D1FAE5" FontSize="12" Margin="0,2,0,0" />
                </VerticalStackLayout>

                <!-- Ver no Mapa Button -->
                <Border Grid.Column="1" 
                        StrokeThickness="0" 
                        BackgroundColor="#145323" 
                        HeightRequest="38" 
                        Padding="14,0" 
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOpenInMap" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="🗺️" FontSize="14" VerticalOptions="Center" />
                        <Label Text="Mapa" TextColor="White" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Kebab Menu Button -->
                <Border Grid.Column="2" 
                        HeightRequest="38" 
                        WidthRequest="38" 
                        BackgroundColor="#145323" 
                        StrokeThickness="0" 
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnKebabMenuClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="⋮" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Departures List -->
        <Grid Grid.Row="1">
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#1b652d" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40" />

            <Label Text="Sem partidas registadas de momento." 
                   TextColor="{StaticResource TextSecondary}" 
                   FontSize="16" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"
                   IsVisible="{Binding IsEmpty}" />

            <RefreshView IsRefreshing="{Binding IsLoading}" Command="{Binding RefreshCommand}" RefreshColor="#1b652d">
                <CollectionView ItemsSource="{Binding Departures}" SelectionMode="Single" SelectionChanged="OnDepartureSelected" Margin="12,12,12,24">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TrainDeparture">
                            <Border StrokeThickness="0" BackgroundColor="{StaticResource CardBackground}" Margin="4,6,4,6" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Opacity="0.08" Radius="5" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                                    <!-- Service Badge -->
                                    <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="{Binding ServiceColorHex}" Padding="10,6" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding ServiceType}" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                    </Border>

                                    <!-- Train Info -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Destination}" TextColor="{StaticResource TextPrimary}" FontSize="17" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Spacing="6" Margin="0,3,0,0">
                                            <Label Text="{Binding TrainNumber, StringFormat='Comboio {0}'}" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                                            <Label Text="•" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                                            <Label Text="{Binding Operator}" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Departure Time & Status -->
                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center">
                                        <Label Text="{Binding DepartureTime}" TextColor="{StaticResource TextPrimary}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                        <Border StrokeThickness="0" BackgroundColor="{Binding ObservationBgColorHex}" Padding="6,2" Margin="0,3,0,0" HorizontalOptions="End">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="4" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Observations}" TextColor="{Binding ObservationColorHex}" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
