<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             x:Class="ParagensV2.Views.TrainMapPage"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="#1b652d" Padding="20,24,20,16">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Opacity="0.2" Radius="10" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding PageTitle}" TextColor="#A7F3D0" FontSize="13" FontAttributes="Bold" />
                <Label Text="{Binding PageSubtitle}" TextColor="White" FontSize="24" FontAttributes="Bold" />
                <Label Text="{Binding PageDescription}" TextColor="#D1FAE5" FontSize="12" />
            </VerticalStackLayout>
        </Border>

        <!-- Leaflet Map WebView -->
        <WebView Grid.Row="1" x:Name="TrainWebView" Navigating="OnMapNavigating" UserAgent="ParagensV2/1.0" />
    </Grid>
</ContentPage>
