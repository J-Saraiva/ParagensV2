<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParagensV2.Views.SettingsPage"
             BackgroundColor="{AppThemeBinding Light=#F0F4F8, Dark=#0B1120}"
             Shell.NavBarIsVisible="False"
             Title="Definições">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="{StaticResource Primary}" Padding="20,24,20,18">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Opacity="0.2" Radius="10" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="⚙️ Configurações" TextColor="#80D8FF" FontSize="13" FontAttributes="Bold" />
                    <Label Text="Definições" TextColor="White" FontSize="24" FontAttributes="Bold" Margin="0,1,0,0" />
                    <Label Text="Aparência e preferências da aplicação" TextColor="#B0BEC5" FontSize="12" Margin="0,1,0,0" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Settings Content -->
        <ScrollView Grid.Row="1" Padding="16,20">
            <VerticalStackLayout Spacing="24">

                <!-- Section: Theme -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="TEMA E APARÊNCIA" 
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           Margin="4,0,0,0" />

                    <!-- Option 1: System Preset -->
                    <Border StrokeThickness="{Binding SystemThemeStrokeThickness}" 
                            Stroke="{Binding SystemThemeBorderBrush}" 
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" 
                            Padding="16,14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="6" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectSystemTheme" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                            <!-- Icon -->
                            <Border Grid.Column="0" HeightRequest="44" WidthRequest="44" BackgroundColor="#E0F2FE" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Label Text="📱" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <!-- Text -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Predefinido do Sistema" 
                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" 
                                       FontSize="16" 
                                       FontAttributes="Bold" />
                                <Label Text="Segue automaticamente o tema do teu dispositivo (claro ou escuro)" 
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                                       FontSize="12" />
                            </VerticalStackLayout>

                            <!-- Active Checkmark Indicator -->
                            <Label Grid.Column="2" 
                                   Text="✓" 
                                   IsVisible="{Binding IsSystemThemeSelected}" 
                                   TextColor="{StaticResource Accent}" 
                                   FontSize="22" 
                                   FontAttributes="Bold" 
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Option 2: Light Mode -->
                    <Border StrokeThickness="{Binding LightThemeStrokeThickness}" 
                            Stroke="{Binding LightThemeBorderBrush}" 
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" 
                            Padding="16,14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="6" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectLightTheme" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                            <!-- Icon -->
                            <Border Grid.Column="0" HeightRequest="44" WidthRequest="44" BackgroundColor="#FEF3C7" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Label Text="☀️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <!-- Text -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Modo Claro" 
                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" 
                                       FontSize="16" 
                                       FontAttributes="Bold" />
                                <Label Text="Fundo suave com alto contraste, ideal para ambientes iluminados" 
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                                       FontSize="12" />
                            </VerticalStackLayout>

                            <!-- Active Checkmark Indicator -->
                            <Label Grid.Column="2" 
                                   Text="✓" 
                                   IsVisible="{Binding IsLightThemeSelected}" 
                                   TextColor="{StaticResource Accent}" 
                                   FontSize="22" 
                                   FontAttributes="Bold" 
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Option 3: Dark Mode -->
                    <Border StrokeThickness="{Binding DarkThemeStrokeThickness}" 
                            Stroke="{Binding DarkThemeBorderBrush}" 
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" 
                            Padding="16,14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="6" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectDarkTheme" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                            <!-- Icon -->
                            <Border Grid.Column="0" HeightRequest="44" WidthRequest="44" BackgroundColor="#312E81" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Label Text="🌙" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <!-- Text -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Modo Escuro" 
                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" 
                                       FontSize="16" 
                                       FontAttributes="Bold" />
                                <Label Text="Tons escuros relaxantes, ideal para descanso visual e poupança de bateria" 
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                                       FontSize="12" />
                            </VerticalStackLayout>

                            <!-- Active Checkmark Indicator -->
                            <Label Grid.Column="2" 
                                   Text="✓" 
                                   IsVisible="{Binding IsDarkThemeSelected}" 
                                   TextColor="{StaticResource Accent}" 
                                   FontSize="22" 
                                   FontAttributes="Bold" 
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Section: About -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="SOBRE A APLICAÇÃO" 
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           Margin="4,0,0,0" />

                    <Border StrokeThickness="0" 
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" 
                            Padding="20,18">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="6" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label Text="🚌 🚇 🚆" FontSize="22" VerticalOptions="Center" />
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="Paragens &amp; Horários" 
                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" />
                                    <Label Text="Versão 2.0 • Mobilidade Urbana" 
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                                           FontSize="12" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" Margin="0,4" />

                            <Label Text="Redes Integradas:" 
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" 
                                   FontSize="12" 
                                   FontAttributes="Bold" />

                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="🚌" FontSize="14" />
                                    <Label Text="STCP — Sociedade de Transportes Colectivos do Porto" 
                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#CBD5E1}" 
                                           FontSize="13" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="🚍" FontSize="14" />
                                    <Label Text="UNIR — Rede Metropolitana do Porto" 
                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#CBD5E1}" 
                                           FontSize="13" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="🚇" FontSize="14" />
                                    <Label Text="Metro do Porto — Linhas A, B, C, D, E, F" 
                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#CBD5E1}" 
                                           FontSize="13" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="🚆" FontSize="14" />
                                    <Label Text="CP — Comboios de Portugal (Rede Ferroviária Nacional)" 
                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#CBD5E1}" 
                                           FontSize="13" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
