<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             xmlns:models="clr-namespace:ParagensV2.Models"
             x:Class="ParagensV2.Views.MapPage"
             Title="{Binding PageTitle}">
    
    <Grid RowDefinitions="*,Auto">
        <!-- Map View -->
        <WebView x:Name="MapWebView" Grid.Row="0" UserAgent="ParagensV2/1.0" />
        
        <!-- Live ETAs View -->
        <Border Grid.Row="1" StrokeThickness="0" BackgroundColor="{StaticResource Background}" Padding="16" HeightRequest="250">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-4" Opacity="0.15" Radius="10" />
            </Border.Shadow>
            
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12" VerticalOptions="Center">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Label Text="📍" FontSize="20" VerticalOptions="Center" />
                        <Label Text="{Binding Stop.Name}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Stop.Code, StringFormat='({0})'}" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" Margin="4,0,0,0" />
                    </HorizontalStackLayout>

                    <!-- Kebab Menu Button -->
                    <Border Grid.Column="1" 
                            HeightRequest="36" 
                            WidthRequest="36" 
                            BackgroundColor="#ECEFF1" 
                            StrokeThickness="0" 
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnKebabMenuClicked" />
                        </Border.GestureRecognizers>
                        <Label Text="⋮" TextColor="{StaticResource TextPrimary}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoadingEtas}" IsVisible="{Binding IsLoadingEtas}" Color="{StaticResource Accent}" />

                <CollectionView Grid.Row="1" ItemsSource="{Binding Etas}" IsVisible="{Binding HasEtas}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:BusArrival">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
                                <Border Grid.Column="0" HeightRequest="40" WidthRequest="40" BackgroundColor="{Binding LineColor}" StrokeThickness="0" Margin="0,0,12,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding LineNumber}" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Destination}" TextColor="{StaticResource TextPrimary}" FontSize="16" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding FormattedEta}" TextColor="{StaticResource Accent}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Grid.Row="1" Text="Sem chegadas previstas de momento." IsVisible="{Binding IsEmpty}" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
