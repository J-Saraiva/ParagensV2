<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             xmlns:models="clr-namespace:ParagensV2.Models"
             x:Class="ParagensV2.Views.LineStopsPage"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="{StaticResource Primary}" Padding="20,24,20,20">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Opacity="0.2" Radius="10" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{Binding Line.LineNumber}" TextColor="White" FontSize="28" FontAttributes="Bold" />
                        <Label Text="{Binding Line.Name}" TextColor="#CFD8DC" FontSize="14" Margin="0,2,0,0" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <!-- Inverter Sentido Button -->
                    <Button Grid.Column="1" 
                            Text="⇄ Inverter Sentido" 
                            FontAttributes="Bold" 
                            FontSize="12" 
                            HeightRequest="38" 
                            CornerRadius="19"
                            BackgroundColor="#28d8c3" 
                            TextColor="#00332C"
                            Padding="14,0"
                            Clicked="OnToggleDirection" />

                    <!-- Kebab Menu Button -->
                    <Border Grid.Column="2" 
                            HeightRequest="38" 
                            WidthRequest="38" 
                            BackgroundColor="#283593" 
                            StrokeThickness="0" 
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="19" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnKebabMenuClicked" />
                        </Border.GestureRecognizers>
                        <Label Text="⋮" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Current Direction Badge -->
                <Border StrokeThickness="0" BackgroundColor="#1E293B" Padding="12,6" HorizontalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Label Text="{Binding DirectionStatusText}" TextColor="#38BDF8" FontSize="12" FontAttributes="Bold" />
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Accent}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40" />

            <CollectionView ItemsSource="{Binding Stops}" SelectionMode="Single" SelectionChanged="OnStopSelected" Margin="12,12,12,24">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:StcpStop">
                        <Border StrokeThickness="0" BackgroundColor="{StaticResource CardBackground}" Margin="4,6,4,6" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Opacity="0.08" Radius="5" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" TextColor="{StaticResource TextPrimary}" FontSize="16" FontAttributes="Bold" />
                                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                        <Border StrokeThickness="0" BackgroundColor="#E0E0E0" Padding="6,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="4" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Code}" TextColor="#333333" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                        <Label Text="{Binding Zone, StringFormat='Zona {0}'}" TextColor="{StaticResource TextSecondary}" FontSize="12" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="➔" TextColor="{StaticResource Accent}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
